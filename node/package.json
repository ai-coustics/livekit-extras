{
  "name": "@ai-coustics/livekit-extras",
  "version": "0.1.0",
  "description": "ai-coustics noise cancellation and VAD for LiveKit Agents",
  "license": "Apache-2.0",
  "author": "ai-coustics GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-coustics/livekit-extras.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run test/analyzer.test.ts test/frame_processor_chain.test.ts test/processor.test.ts test/vad.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:e2e": "vitest run test/e2e-room.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-coustics/aic-sdk": "^0.23.0",
    "@livekit/typed-emitter": "^3.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependencies": {
    "@livekit/agents": ">=1.0.43 <2",
    "@livekit/rtc-node": ">=0.13.24 <1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@livekit/agents": "^1.0.43",
    "@livekit/rtc-node": "^0.13.24",
    "livekit-server-sdk": "^2.14.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
